limit_conn_zone $server_name zone=capswriter_total:1m;
limit_req_zone $binary_remote_addr zone=capswriter_rate:1m rate=20r/s;
server {
    listen 80;
    server_name __PUBLIC_IP__;
    access_log off;
    error_log /dev/null crit;
    location ^~ /.well-known/acme-challenge/ { root /srv/capswriter/acme; }
    location / { return 308 https://__PUBLIC_IP__$request_uri; }
}
server {
    listen 443 ssl;
    server_name __PUBLIC_IP__;
    ssl_certificate /etc/letsencrypt/live/capswriter-ip/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/capswriter-ip/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log off;
    error_log /dev/null crit;
    client_max_body_size 27m;
    client_body_buffer_size 27m;
    client_body_timeout 30s;
    limit_conn capswriter_total 8;
    limit_req zone=capswriter_rate burst=40 nodelay;
    add_header X-Content-Type-Options nosniff always;
    location /v1/ {
        if ($http_authorization = "") { return 401; }
        proxy_pass http://127.0.0.1:8765;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Authorization $http_authorization;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 210s;
        proxy_send_timeout 210s;
    }
    location / { return 404; }
}
