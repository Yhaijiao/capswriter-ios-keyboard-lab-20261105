[Unit]
Description=CapsWriter authenticated loopback gateway
After=capswriter-asr.service
Requires=capswriter-asr.service

[Service]
Type=simple
User=capswriter
Group=capswriter
WorkingDirectory=/srv/capswriter/app
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/srv/capswriter/venv-bridge/bin/python -B /srv/capswriter/app/cloud/gateway.py --private-root /srv/capswriter/private/desktop --token-file /srv/capswriter/private/bridge-token.txt --hotwords-state /srv/capswriter/private/hotword-backups --enable-hotword-save
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# A shared writable mount is required for atomic rename from backups to hot.txt.
# Separate writable bind mounts make that rename fail with EXDEV.
ReadWritePaths=/srv/capswriter/private
ReadOnlyPaths=/srv/capswriter/private/bridge-token.txt /srv/capswriter/private/desktop/core /srv/capswriter/private/desktop/models /srv/capswriter/private/desktop/config_client.py /srv/capswriter/private/desktop/config_server.py /srv/capswriter/private/desktop/private-manifest.json
ProtectHome=true
StandardOutput=null
StandardError=null
MemoryMax=1536M

[Install]
WantedBy=multi-user.target
